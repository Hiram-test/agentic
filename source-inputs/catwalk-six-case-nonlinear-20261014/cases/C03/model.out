  5801  BF,ALL,TEMP,-15 ! 全节点均匀温度，摄氏度；对应原 NALL 温度卡  
  5802  TIME,2 ! 累计伪时间，末步值用于检查达到全荷载 
  5803  DELTIM,0.025,0.000001,0.05 ! 初始和最大增量沿用已验证风载设置，最小增量为百万分之一  
  5804  KBC,0 ! 从前一平衡态平滑加载到当前总力及温度  
  5805  SOLVE ! 求当前几何非线性平衡，不进行线性结果叠加
  5806  FINISH ! 结束两个非线性分析步 
  5807  /POST1 ! 读取实际已收敛结果集 
  5808  SET,LAST ! 定位最后已收敛结果以取得结果集总数  
  5809  *GET,nsets,ACTIVE,0,SET,NSET ! 结果集数量，无量纲  
  5810  *CFOPEN,history,csv ! 导出每个收敛状态的时间与极值，单位m/N
  5811  *VWRITE,'set,time,max_uy,max_usum,node730_uy,node1128_uy,max_tension,min_force' ! 写历史表列名；下一行格式：字符串输出格式  
  5812  (A) 
  5813  *DO,iset,1,nsets ! 按收敛结果集逐个读取，索引从1开始
  5814  SET,,,,,,,iset ! 读取指定序号结果集
  5815  *GET,tval,ACTIVE,0,SET,TIME ! 实际累计伪时间 
  5816  umax=0 ! 当前结果集的最大位移合量初值为0m
  5817  ymax=0 ! 当前结果集的最大横向位移绝对值初值为0m   
  5818  hnid=0 ! 历史极值扫描从第一个实际节点开始   
  5819  *DO,hni,1,1125 ! 扫描本结果集所有实际节点   
  5820  hnid=NDNEXT(hnid) ! 取得下一个实际节点 
  5821  *GET,hux,NODE,hnid,U,X ! 节点纵向位移m
  5822  *GET,huy,NODE,hnid,U,Y ! 节点横向位移m
  5823  *GET,huz,NODE,hnid,U,Z ! 节点竖向位移m
  5824  umax=MAX(umax,SQRT(hux*hux+huy*huy+huz*huz)) ! 更新最大三维位移合量m  
  5825  ymax=MAX(ymax,ABS(huy)) ! 更新最大横向位移绝对值m
  5826  *ENDDO ! 结束本结果集节点极值扫描   
  5827  *GET,y730,NODE,730,U,Y ! 原锚点730横向位移m，应为0
  5828  *GET,y1128,NODE,1128,U,Y ! 原节点1128横向位移m   
  5829  ETABLE,AF,SMISC,1 ! 读取LINK180实际轴力N，拉力为正   
  5830  ESORT,ETAB,AF ! 将轴力表排序供最大最小值提取  
  5831  *GET,nmax,SORT,0,MAX ! 当前最大单元轴力N
  5832  *GET,nmin,SORT,0,MIN ! 当前最小单元轴力N
  5833  *VWRITE,iset,tval,ymax,umax,y730,y1128,nmax,nmin ! 输出当前收敛状态摘要；下一行格式：八列CSV格式   
  5834  (F8.0,7(",",E24.15))
  5835  *ENDDO ! 结束历史结果循环   
  5836  *CFCLOS ! 关闭历史输出
  5837  SET,LAST ! 导出最终实际收敛状态   
  5838  EUSORT ! 恢复单元编号次序   
  5839  ETABLE,AF,SMISC,1 ! 刷新最后状态实际轴力N 
  5840  *CFOPEN,final_nodes,csv ! 最终节点位移和反力，单位m与N 
  5841  *VWRITE,'node,ux,uy,uz,rx,ry,rz' ! 节点结果列名；下一行格式：字符串输出格式 
  5842  (A) 
  5843  nid=0 ! 从编号0开始查询第一个实际节点 
  5844  *DO,ii,1,1125 ! 遍历全部实际节点，不包含编号空档
  5845  nid=NDNEXT(nid) ! 按原编号取下一现有节点 
  5846  *GET,ux,NODE,nid,U,X ! 提取当前节点相应位移m或反力N
  5847  *GET,uy,NODE,nid,U,Y ! 提取当前节点相应位移m或反力N
  5848  *GET,uz,NODE,nid,U,Z ! 提取当前节点相应位移m或反力N
  5849  rx=0 ! 自由分量没有支承反力，默认记录0N  
  5850  ry=0 ! 自由分量没有支承反力，默认记录0N  
  5851  rz=0 ! 自由分量没有支承反力，默认记录0N  
  5852  *IF,nid,EQ,1,THEN ! 当前节点是该原支承节点时读取反力
  5853  *GET,rx,NODE,nid,RF,FX ! 读取该真实约束方向反力N 
  5854  *ENDIF ! 结束该支承节点判断
  5855  *IF,nid,EQ,1,THEN ! 当前节点是该原支承节点时读取反力
  5856  *GET,ry,NODE,nid,RF,FY ! 读取该真实约束方向反力N 
  5857  *ENDIF ! 结束该支承节点判断
  5858  *IF,nid,EQ,1,THEN ! 当前节点是该原支承节点时读取反力
  5859  *GET,rz,NODE,nid,RF,FZ ! 读取该真实约束方向反力N 
  5860  *ENDIF ! 结束该支承节点判断
  5861  *IF,nid,EQ,154,THEN ! 当前节点是该原支承节点时读取反力  
  5862  *GET,rx,NODE,nid,RF,FX ! 读取该真实约束方向反力N 
  5863  *ENDIF ! 结束该支承节点判断
  5864  *IF,nid,EQ,154,THEN ! 当前节点是该原支承节点时读取反力  
  5865  *GET,ry,NODE,nid,RF,FY ! 读取该真实约束方向反力N 
  5866  *ENDIF ! 结束该支承节点判断
  5867  *IF,nid,EQ,154,THEN ! 当前节点是该原支承节点时读取反力  
  5868  *GET,rz,NODE,nid,RF,FZ ! 读取该真实约束方向反力N 
  5869  *ENDIF ! 结束该支承节点判断
  5870  *IF,nid,EQ,450,THEN ! 当前节点是该原支承节点时读取反力  
  5871  *GET,rx,NODE,nid,RF,FX ! 读取该真实约束方向反力N 
  5872  *ENDIF ! 结束该支承节点判断
  5873  *IF,nid,EQ,450,THEN ! 当前节点是该原支承节点时读取反力  
  5874  *GET,ry,NODE,nid,RF,FY ! 读取该真实约束方向反力N 
  5875  *ENDIF ! 结束该支承节点判断
  5876  *IF,nid,EQ,450,THEN ! 当前节点是该原支承节点时读取反力  
  5877  *GET,rz,NODE,nid,RF,FZ ! 读取该真实约束方向反力N 
