  6020  (A) 
  6021  eid=0 ! 开始遍历原单元编号 
  6022  *DO,ii,1,1194 ! 遍历原单元总数   
  6023  eid=ELNEXT(eid) ! 查询下一个实际单元号
  6024  *GET,aforce,ELEM,eid,ETAB,AF ! 提取该单元当前轴力N 
  6025  *VWRITE,eid,aforce ! 写原单元号和轴力N；下一行格式：两列CSV数值格式
  6026  (F10.0,",",E24.15)  
  6027  *ENDDO ! 单元导出结束 
  6028  *CFCLOS ! 关闭单元结果文件  
  6029  ALLSEL,ALL ! 选择全部物理对象   
  6030  RSYS,0 ! 端力采用全局直角坐标 
  6031  *CFOPEN,element_end_forces,csv ! 输出每个物理单元的端力  
  6032  *VWRITE,'eid,node,Fx,Fy,Fz' ! 列名，下一行采用字符串格式   
  6033  (A) 
  6034  ee=0 ! 从第一个物理单元开始   
  6035  *DO,ii,1,1194 ! 遍历所有原单元   
  6036  ee=ELNEXT(ee) ! 查询下一个单元编号 
  6037  *DO,jj,1,2 ! 每个轴杆输出两端节点 
  6038  *GET,nn,ELEM,ee,NODE,jj ! 当前端点编号
  6039  *GET,fx,ELEM,ee,EFOR,nn,FX ! 全局纵向端力，牛顿
  6040  *GET,fy,ELEM,ee,EFOR,nn,FY ! 全局横向端力，牛顿
  6041  *GET,fz,ELEM,ee,EFOR,nn,FZ ! 全局竖向端力，牛顿
  6042  *VWRITE,ee,nn,fx,fy,fz ! 输出节点及端力，下一行为数值格式   
  6043  (F10.0,",",F10.0,3(",",E24.15)) 
  6044  *ENDDO ! 结束当前单元两端循环 
  6045  *ENDDO ! 结束全体单元循环   
  6046  *CFCLOS ! 关闭端力输出
  6047  FINISH ! 结束后处理
  6048  /EXIT,NOSAVE ! 正常退出并保留结果  

